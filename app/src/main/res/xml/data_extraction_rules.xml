<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup rules: same policy as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="souschef.db" />
        <include domain="sharedpref" path="souschef_settings.xml" />
        <exclude domain="sharedpref" path="souschef_secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="souschef.db" />
        <include domain="sharedpref" path="souschef_settings.xml" />
        <exclude domain="sharedpref" path="souschef_secrets.xml" />
    </device-transfer>
</data-extraction-rules>
